apiVersion: v1
kind: Secret
metadata:
  name: app-runtime
  namespace: {{ app_namespace }}
type: Opaque
data:
  DB_USER_PASS_LIVE: {{ db_password | b64encode | to_json }}
  AES_ENC_KEY: {{ aes_key | b64encode | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-jwt
  namespace: {{ app_namespace }}
type: Opaque
data:
  jwtRS256.key: {{ lookup('file', jwt_private_key_path) | b64encode | to_json }}
  jwtRS256.key.pub: {{ lookup('file', jwt_public_key_path) | b64encode | to_json }}
---
apiVersion: v1
kind: Secret
metadata:
  name: app-tls
  namespace: {{ app_namespace }}
type: kubernetes.io/tls
data:
  tls.crt: {{ lookup('file', tls_certificate_path) | b64encode | to_json }}
  tls.key: {{ lookup('file', tls_private_key_path) | b64encode | to_json }}
{% if registry_username | length > 0 %}
---
apiVersion: v1
kind: Secret
metadata:
  name: dockerhub
  namespace: {{ app_namespace }}
type: kubernetes.io/dockerconfigjson
data:
  .dockerconfigjson: {{ {'auths': {'https://index.docker.io/v1/': {'auth': (registry_username ~ ':' ~ registry_password) | b64encode}}} | to_json | b64encode | to_json }}
{% endif %}
